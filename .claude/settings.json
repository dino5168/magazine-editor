{
  "permissions": {
    "deny": [
      "Read(./node_modules/**)",
      "Read(./dist/**)",
      "Read(./src-tauri/target/**)",
      "Read(./src-tauri/gen/schemas/**)",
      "Read(./package-lock.json)",
      "Read(./src-tauri/Cargo.lock)",
      "Read(./src-tauri/src/export/flipbook/vendor/*.js)",
      "Read(./fonts/*.ttf)",
      "Read(./fonts/*.otf)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-check.ps1\"; exit $LASTEXITCODE",
            "timeout": 120,
            "statusMessage": "型別檢查與相關測試中..."
          }
        ]
      }
    ]
  }
}
