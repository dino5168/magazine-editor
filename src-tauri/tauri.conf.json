{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "magazine-editor",
    "version":  "0.1.0",
    "identifier":  "com.mycompany.magazineeditor",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "雜誌編輯軟體",
                                    "width":  800,
                                    "height":  600,
                                    "minWidth":  1024,
                                    "minHeight":  640,
                                    "maximized":  true,
                                    "dragDropEnabled":  false
                                }
                            ],
                "security":  {
                                 "csp":  "default-src \u0027self\u0027; script-src \u0027self\u0027; style-src \u0027self\u0027 \u0027unsafe-inline\u0027; img-src \u0027self\u0027 asset: http://asset.localhost data: blob:; font-src \u0027self\u0027 data:; connect-src \u0027self\u0027 ipc: http://ipc.localhost",
                                 "dangerousDisableAssetCspModification":  [
                                                                              "style-src"
                                                                          ]
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ]
               }
}