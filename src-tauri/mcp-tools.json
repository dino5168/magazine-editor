[
  {
    "name": "get_document",
    "title": "文件摘要",
    "description": "取得目前在雜誌編輯軟體中開啟的文件摘要：名稱、頁數、主頁數、紙張尺寸、邊界、是否有未存檔變更、使用者正在看的頁面。長度單位一律是 pt（1/72 inch），座標原點是頁面左上角。",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true
    }
  },
  {
    "name": "list_pages",
    "title": "頁面清單",
    "description": "列出所有頁面（依頁序，index 從 1 起算）與主頁：id、名稱、尺寸（pt）、背景色、套用的主頁、物件數。主頁是頁面共用的底層內容。",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true
    }
  },
  {
    "name": "list_elements",
    "title": "物件清單",
    "description": "列出一個頁面或主頁上的物件，由最底層到最上層：id、類型（text / shape / image）、位置與尺寸（pt，外框旋轉前的左上角）、旋轉角度、文字摘要（最多 80 字）。省略 pageId 時是使用者正在看的頁面。不含主頁帶來的物件與頁碼。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "pageId": {
          "type": "string",
          "minLength": 1,
          "description": "頁面或主頁的 id（由 list_pages 取得）"
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true
    }
  },
  {
    "name": "get_element",
    "title": "物件內容",
    "description": "取得單一物件的完整欄位，以及它所在的頁面 id 與圖層位置（0 = 最底層）。頁面與主頁上的物件都找得到。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "物件 id（由 list_elements 取得）"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true
    }
  },
  {
    "name": "list_commands",
    "title": "選單指令清單",
    "description": "列出 App 選單列上的所有指令：id、名稱、在選單中的位置、快捷鍵、勾選項目（視圖、工具面板）目前是否勾選、能不能執行（不能時附原因，例如尚未實作）。",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true
    }
  },
  {
    "name": "run_command",
    "title": "執行選單指令",
    "description": "執行一個選單指令，效果和使用者點選單相同（例如 file.save 儲存、view.grid 切換格線、panel.layers 開關圖層面板）。勾選項目會切換並回傳切換後的狀態。會開對話框的指令（開啟、另存、匯出、設定…）只負責打開對話框，由使用者在 App 裡完成，工具不等待結果。不能執行的指令（尚未實作）回傳錯誤、不做任何事。先用 list_commands 查看。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "file.new",
            "file.open",
            "file.save",
            "file.saveAs",
            "file.library",
            "file.importImage",
            "file.importPages",
            "file.exportPng",
            "file.exportJpeg",
            "file.exportPdf",
            "file.exportEpub",
            "view.rulers",
            "view.grid",
            "view.contentGuides",
            "view.margins",
            "view.snap",
            "settings.pageSetup",
            "settings.pageNumbers",
            "settings.grid",
            "settings.mcp",
            "settings.themeLight",
            "settings.themeDark",
            "settings.themeSystem",
            "panel.templates",
            "panel.text",
            "panel.photos",
            "panel.elements",
            "panel.draw",
            "panel.upload",
            "panel.background",
            "panel.pages",
            "panel.properties",
            "panel.styles",
            "panel.layers",
            "panel.resetLayout"
          ],
          "description": "指令 id（由 list_commands 取得）"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false
    }
  },
  {
    "name": "add_text",
    "title": "新增文字",
    "description": "在頁面加一個文字物件（放在最上層），回傳新物件的 id。x / y 是文字框左上角（pt），width 是換行寬度（預設 280），高度跟著文字。省略 pageId = 使用者正在看的頁面；指定別頁不會切換使用者的畫面。沒有 style 時的預設：黑體 11 pt、靠左、#171717，不連到樣式。style：連到文字樣式（名稱或 id），文字先取樣式的值，再套用這次給的樣式欄位（和樣式不同的欄位就是覆寫；之後改樣式時覆寫的欄位不跟著變）。文字樣式欄位（都可省略）：fontSize、font（黑體 / 明體 / 楷體 / 圓體）、bold、italic、underline、strikethrough、align（left / center / right）、textColor、shadow。 一次呼叫 = 一筆復原紀錄。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "pageId": {
          "type": "string",
          "minLength": 1,
          "description": "頁面或主頁的 id（由 list_pages 取得）"
        },
        "style": {
          "type": "string",
          "minLength": 1,
          "description": "文字樣式的名稱或 id（由 list_text_styles 取得）"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000,
          "description": "文字內容，\\n 換行"
        },
        "x": {
          "type": "number",
          "minimum": -10000,
          "maximum": 10000
        },
        "y": {
          "type": "number",
          "minimum": -10000,
          "maximum": 10000
        },
        "width": {
          "description": "換行寬度（pt），預設 280",
          "type": "number",
          "minimum": 4,
          "maximum": 10000
        },
        "rotation": {
          "type": "number",
          "minimum": -360,
          "maximum": 360,
          "description": "旋轉角度（度，順時針，繞外框左上角）"
        },
        "fontSize": {
          "type": "number",
          "minimum": 6,
          "maximum": 400,
          "description": "字級（pt）"
        },
        "font": {
          "type": "string",
          "enum": [
            "黑體",
            "明體",
            "楷體",
            "圓體"
          ],
          "description": "字體"
        },
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "underline": {
          "type": "boolean"
        },
        "strikethrough": {
          "type": "boolean"
        },
        "align": {
          "type": "string",
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "textColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}(?:[0-9a-fA-F]{2})?$",
          "description": "文字顏色，#rrggbb 或 #rrggbbaa"
        },
        "shadow": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "color": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}(?:[0-9a-fA-F]{2})?$",
                  "description": "#rrggbb 或 #rrggbbaa（aa = 不透明度，ff 不透明）"
                },
                "offsetX": {
                  "type": "number",
                  "minimum": -50,
                  "maximum": 50
                },
                "offsetY": {
                  "type": "number",
                  "minimum": -50,
                  "maximum": 50
                }
              },
              "required": [
                "color",
                "offsetX",
                "offsetY"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ],
          "description": "文字硬陰影（不模糊，偏移以頁面方向為準，pt）；null = 沒有陰影"
        }
      },
      "required": [
        "text",
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false
    }
  },
  {
    "name": "add_shape",
    "title": "新增圖形",
    "description": "在頁面加一個圖形（放在最上層），回傳新物件的 id。shape：rect 矩形、roundedRect 圓角矩形、ellipse 橢圓、triangle 三角形、star 星形；圖形撐滿 x / y / width / height 指定的外框（pt）。預設填色 #64748b、沒有邊框。text 是圖形內的文字（預設置中、垂直置中），它的樣式欄位（都可省略）：fontSize、font（黑體 / 明體 / 楷體 / 圓體）、bold、italic、underline、strikethrough、align（left / center / right）、textColor、shadow。 style 讓圖形內文字連到文字樣式（需要同時給 text）。省略 pageId = 使用者正在看的頁面。一次呼叫 = 一筆復原紀錄。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "pageId": {
          "type": "string",
          "minLength": 1,
          "description": "頁面或主頁的 id（由 list_pages 取得）"
        },
        "shape": {
          "type": "string",
          "enum": [
            "rect",
            "roundedRect",
            "ellipse",
            "triangle",
            "star"
          ]
        },
        "x": {
          "type": "number",
          "minimum": -10000,
          "maximum": 10000
        },
        "y": {
          "type": "number",
          "minimum": -10000,
          "maximum": 10000
        },
        "width": {
          "type": "number",
          "minimum": 4,
          "maximum": 10000
        },
        "height": {
          "type": "number",
          "minimum": 4,
          "maximum": 10000
        },
        "rotation": {
          "type": "number",
          "minimum": -360,
          "maximum": 360,
          "description": "旋轉角度（度，順時針，繞外框左上角）"
        },
        "fill": {
          "description": "填色，#rrggbb 或 #rrggbbaa（#00000000 = 透明）",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}(?:[0-9a-fA-F]{2})?$"
        },
        "stroke": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "color": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}(?:[0-9a-fA-F]{2})?$",
                  "description": "#rrggbb 或 #rrggbbaa（aa = 不透明度，ff 不透明）"
                },
                "width": {
                  "type": "number",
                  "minimum": 0.25,
                  "maximum": 100,
                  "description": "線寬（pt），畫在外框線中心"
                },
                "dash": {
                  "type": "string",
                  "enum": [
                    "solid",
                    "dashed",
                    "dotted"
                  ]
                }
              },
              "required": [
                "color",
                "width",
                "dash"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ],
          "description": "邊框；null = 沒有邊框"
        },
        "text": {
          "description": "圖形內的文字，\\n 換行",
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "style": {
          "type": "string",
          "minLength": 1,
          "description": "文字樣式的名稱或 id（由 list_text_styles 取得）"
        },
        "verticalAlign": {
          "type": "string",
          "enum": [
            "top",
            "middle",
            "bottom"
          ],
          "description": "圖形內文字的垂直對齊"
        },
        "fontSize": {
          "type": "number",
          "minimum": 6,
          "maximum": 400,
          "description": "字級（pt）"
        },
        "font": {
          "type": "string",
          "enum": [
            "黑體",
            "明體",
            "楷體",
            "圓體"
          ],
          "description": "字體"
        },
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "underline": {
          "type": "boolean"
        },
        "strikethrough": {
          "type": "boolean"
        },
        "align": {
          "type": "string",
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "textColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}(?:[0-9a-fA-F]{2})?$",
          "description": "文字顏色，#rrggbb 或 #rrggbbaa"
        },
        "shadow": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "color": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}(?:[0-9a-fA-F]{2})?$",
                  "description": "#rrggbb 或 #rrggbbaa（aa = 不透明度，ff 不透明）"
                },
                "offsetX": {
                  "type": "number",
                  "minimum": -50,
                  "maximum": 50
                },
                "offsetY": {
                  "type": "number",
                  "minimum": -50,
                  "maximum": 50
                }
              },
              "required": [
                "color",
                "offsetX",
                "offsetY"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ],
          "description": "文字硬陰影（不模糊，偏移以頁面方向為準，pt）；null = 沒有陰影"
        }
      },
      "required": [
        "shape",
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false
    }
  },
  {
    "name": "update_element",
    "title": "修改物件",
    "description": "修改一個物件（頁面或主頁上的都可以，用 id 找），只改有給的欄位，回傳是否有變更。位置與尺寸：x、y、width、height（文字物件沒有 height）、rotation。文字物件：text 與文字樣式。圖形：fill、stroke、cornerRadius（只有矩形）、text（圖形內文字，空字串 = 移除）、verticalAlign 與文字樣式（套用在圖形內文字）。圖片只能改位置與尺寸。文字樣式欄位（都可省略）：fontSize、font（黑體 / 明體 / 楷體 / 圓體）、bold、italic、underline、strikethrough、align（left / center / right）、textColor、shadow。 給了不屬於該物件類型的欄位會回錯誤、不做修改。一次呼叫 = 一筆復原紀錄。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "物件 id（由 list_elements 取得）"
        },
        "x": {
          "type": "number",
          "minimum": -10000,
          "maximum": 10000
        },
        "y": {
          "type": "number",
          "minimum": -10000,
          "maximum": 10000
        },
        "width": {
          "type": "number",
          "minimum": 4,
          "maximum": 10000
        },
        "height": {
          "type": "number",
          "minimum": 4,
          "maximum": 10000
        },
        "rotation": {
          "type": "number",
          "minimum": -360,
          "maximum": 360,
          "description": "旋轉角度（度，順時針，繞外框左上角）"
        },
        "text": {
          "description": "文字內容；圖形的空字串 = 移除圖形內文字",
          "type": "string",
          "maxLength": 10000
        },
        "fill": {
          "description": "圖形填色",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}(?:[0-9a-fA-F]{2})?$"
        },
        "stroke": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "color": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}(?:[0-9a-fA-F]{2})?$",
                  "description": "#rrggbb 或 #rrggbbaa（aa = 不透明度，ff 不透明）"
                },
                "width": {
                  "type": "number",
                  "minimum": 0.25,
                  "maximum": 100,
                  "description": "線寬（pt），畫在外框線中心"
                },
                "dash": {
                  "type": "string",
                  "enum": [
                    "solid",
                    "dashed",
                    "dotted"
                  ]
                }
              },
              "required": [
                "color",
                "width",
                "dash"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ],
          "description": "邊框；null = 沒有邊框"
        },
        "cornerRadius": {
          "description": "矩形圓角（pt），超過短邊一半時取一半",
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        "verticalAlign": {
          "type": "string",
          "enum": [
            "top",
            "middle",
            "bottom"
          ],
          "description": "圖形內文字的垂直對齊"
        },
        "fontSize": {
          "type": "number",
          "minimum": 6,
          "maximum": 400,
          "description": "字級（pt）"
        },
        "font": {
          "type": "string",
          "enum": [
            "黑體",
            "明體",
            "楷體",
            "圓體"
          ],
          "description": "字體"
        },
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "underline": {
          "type": "boolean"
        },
        "strikethrough": {
          "type": "boolean"
        },
        "align": {
          "type": "string",
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "textColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}(?:[0-9a-fA-F]{2})?$",
          "description": "文字顏色，#rrggbb 或 #rrggbbaa"
        },
        "shadow": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "color": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}(?:[0-9a-fA-F]{2})?$",
                  "description": "#rrggbb 或 #rrggbbaa（aa = 不透明度，ff 不透明）"
                },
                "offsetX": {
                  "type": "number",
                  "minimum": -50,
                  "maximum": 50
                },
                "offsetY": {
                  "type": "number",
                  "minimum": -50,
                  "maximum": 50
                }
              },
              "required": [
                "color",
                "offsetX",
                "offsetY"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ],
          "description": "文字硬陰影（不模糊，偏移以頁面方向為準，pt）；null = 沒有陰影"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false
    }
  },
  {
    "name": "delete_elements",
    "title": "刪除物件",
    "description": "刪除同一頁（或同一主頁）上的一個或多個物件，回傳刪除的數量。一次呼叫 = 一筆復原紀錄，使用者可以 Ctrl+Z 或呼叫 undo 復原。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "ids": {
          "minItems": 1,
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "物件 id（由 list_elements 取得）"
          }
        }
      },
      "required": [
        "ids"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false
    }
  },
  {
    "name": "add_page",
    "title": "新增頁面",
    "description": "新增空白頁面，回傳新頁面的 id，並切到第一個新頁面（和使用者在 App 裡新增頁面相同）。省略的欄位用 App 的預設：加在最後一頁之後、1 頁、套用最後一頁的主頁（沒有就不套用）。新頁面的尺寸和插入處旁邊的頁面相同，背景用主頁的背景。一次呼叫 = 一筆復原紀錄。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "count": {
          "description": "頁數，1–100",
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "pageNumber": {
          "description": "插在第幾頁的前面或後面（1 起算），預設最後一頁",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "side": {
          "description": "插在 pageNumber 那一頁之前或之後，預設 after",
          "type": "string",
          "enum": [
            "before",
            "after"
          ]
        },
        "masterId": {
          "description": "套用的主頁 id；null = 不套用",
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false
    }
  },
  {
    "name": "add_master",
    "title": "新增主頁",
    "description": "新增一個空白主頁，回傳新主頁的 id 與名稱，並切到編輯這個主頁（和使用者在 App 裡新增主頁相同）。主頁放每一頁都要有的內容：之後用 add_text / add_shape 指定 pageId = 主頁 id 加內容，用 add_page 的 masterId 讓新頁面套用它。省略的欄位用 App 的預設：名稱 Master A、B…（第一個沒用過的）；正在編輯某個主頁時以它為基礎，否則不以任何主頁為基礎；背景 #ffffff。尺寸和使用者正在看的頁面相同。名稱最多 50 字；以主頁為基礎時，一條鏈最多 8 層、不能循環。一次呼叫 = 一筆復原紀錄。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "description": "主頁名稱",
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "parentId": {
          "description": "以哪個主頁為基礎（先畫那個主頁的內容）；null = 不以任何主頁為基礎",
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "background": {
          "description": "主頁背景，#rrggbb；只在編輯主頁時看到，也是之後套用它的新頁面的預設背景",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false
    }
  },
  {
    "name": "set_page_master",
    "title": "頁面套用主頁",
    "description": "讓一個或多個頁面套用某個主頁（主頁的內容畫在頁面物件之下），或取消套用（masterId = null）。只能指定頁面，不能指定主頁（主頁以誰為基礎是另一回事）。頁面的背景不變。不會切換使用者的畫面。已經套用該主頁的頁面不變；回傳 changed 表示有沒有任何頁面改變。一次呼叫 = 一筆復原紀錄。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "pageIds": {
          "minItems": 1,
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "頁面 id（由 list_pages 的 pages 取得）"
        },
        "masterId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "主頁 id（由 list_pages 的 masters 取得）；null = 取消套用"
        }
      },
      "required": [
        "pageIds",
        "masterId"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false
    }
  },
  {
    "name": "list_text_styles",
    "title": "文字樣式清單",
    "description": "列出文件的文字樣式（樣式表）：id、名稱、樣式欄位（同 add_text 的 font / fontSize / bold / italic / underline / strikethrough / align / textColor / shadow）與連到它的文字數（文字物件與圖形內文字，含主頁）。文字連到樣式後，改樣式時沒被覆寫的欄位會跟著變。",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true
    }
  },
  {
    "name": "add_text_style",
    "title": "新增文字樣式",
    "description": "在樣式表新增一個文字樣式，回傳 id。名稱必填（最多 50 字、不可和其他樣式同名）；省略的欄位用內建「內文」的值（黑體 11 pt、靠左、#171717）。文字樣式欄位（都可省略）：fontSize、font（黑體 / 明體 / 楷體 / 圓體）、bold、italic、underline、strikethrough、align（left / center / right）、textColor、shadow。 新增後可以用 apply_text_style 或 add_text 的 style 讓文字連到它。一次呼叫 = 一筆復原紀錄。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "樣式名稱"
        },
        "fontSize": {
          "type": "number",
          "minimum": 6,
          "maximum": 400,
          "description": "字級（pt）"
        },
        "font": {
          "type": "string",
          "enum": [
            "黑體",
            "明體",
            "楷體",
            "圓體"
          ],
          "description": "字體"
        },
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "underline": {
          "type": "boolean"
        },
        "strikethrough": {
          "type": "boolean"
        },
        "align": {
          "type": "string",
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "textColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}(?:[0-9a-fA-F]{2})?$",
          "description": "文字顏色，#rrggbb 或 #rrggbbaa"
        },
        "shadow": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "color": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}(?:[0-9a-fA-F]{2})?$",
                  "description": "#rrggbb 或 #rrggbbaa（aa = 不透明度，ff 不透明）"
                },
                "offsetX": {
                  "type": "number",
                  "minimum": -50,
                  "maximum": 50
                },
                "offsetY": {
                  "type": "number",
                  "minimum": -50,
                  "maximum": 50
                }
              },
              "required": [
                "color",
                "offsetX",
                "offsetY"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ],
          "description": "文字硬陰影（不模糊，偏移以頁面方向為準，pt）；null = 沒有陰影"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false
    }
  },
  {
    "name": "update_text_style",
    "title": "修改文字樣式",
    "description": "修改文字樣式的欄位或名稱，只改有給的欄位。連到它的文字（所有頁面與主頁）會跟著改，但各自覆寫（和舊樣式不同）的欄位不變。文字樣式欄位（都可省略）：fontSize、font（黑體 / 明體 / 楷體 / 圓體）、bold、italic、underline、strikethrough、align（left / center / right）、textColor、shadow。 回傳是否有變更與受影響的文字數。一次呼叫 = 一筆復原紀錄。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "style": {
          "type": "string",
          "minLength": 1,
          "description": "文字樣式的名稱或 id（由 list_text_styles 取得）"
        },
        "name": {
          "description": "新名稱",
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "fontSize": {
          "type": "number",
          "minimum": 6,
          "maximum": 400,
          "description": "字級（pt）"
        },
        "font": {
          "type": "string",
          "enum": [
            "黑體",
            "明體",
            "楷體",
            "圓體"
          ],
          "description": "字體"
        },
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "underline": {
          "type": "boolean"
        },
        "strikethrough": {
          "type": "boolean"
        },
        "align": {
          "type": "string",
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "textColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}(?:[0-9a-fA-F]{2})?$",
          "description": "文字顏色，#rrggbb 或 #rrggbbaa"
        },
        "shadow": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "color": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}(?:[0-9a-fA-F]{2})?$",
                  "description": "#rrggbb 或 #rrggbbaa（aa = 不透明度，ff 不透明）"
                },
                "offsetX": {
                  "type": "number",
                  "minimum": -50,
                  "maximum": 50
                },
                "offsetY": {
                  "type": "number",
                  "minimum": -50,
                  "maximum": 50
                }
              },
              "required": [
                "color",
                "offsetX",
                "offsetY"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ],
          "description": "文字硬陰影（不模糊，偏移以頁面方向為準，pt）；null = 沒有陰影"
        }
      },
      "required": [
        "style"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false
    }
  },
  {
    "name": "delete_text_style",
    "title": "刪除文字樣式",
    "description": "刪除文字樣式。連到它的文字外觀不變，只是不再連到樣式。回傳取消連結的文字數。一次呼叫 = 一筆復原紀錄。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "style": {
          "type": "string",
          "minLength": 1,
          "description": "文字樣式的名稱或 id（由 list_text_styles 取得）"
        }
      },
      "required": [
        "style"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false
    }
  },
  {
    "name": "apply_text_style",
    "title": "套用文字樣式",
    "description": "讓同一頁（或同一主頁）的文字物件與圖形內文字連到文字樣式，並取樣式的所有值（清除覆寫）；style 為 null = 只取消連結、外觀不變。圖片與沒有文字的圖形會略過並列在 skipped。一次呼叫 = 一筆復原紀錄。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "ids": {
          "minItems": 1,
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "物件 id（由 list_elements 取得）"
          }
        },
        "style": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "description": "文字樣式的名稱或 id（由 list_text_styles 取得）"
            },
            {
              "type": "null"
            }
          ],
          "description": "文字樣式的名稱或 id；null = 取消連結"
        }
      },
      "required": [
        "ids",
        "style"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false
    }
  },
  {
    "name": "list_library_items",
    "title": "素材清單",
    "description": "列出專案素材庫（使用者匯入的圖片、文字檔、音訊）的資料夾與素材，新匯入的在前。素材：id、名稱、種類（image / text / audio）、所在資料夾路徑（null = 未分類）、檔案大小（bytes）；圖片另有像素尺寸 width / height，文字檔另有開頭摘錄。可依種類、名稱（包含，不分大小寫）、資料夾（含子資料夾）篩選；垃圾桶裡的素材預設不列，includeTrashed 為 true 時排在最後。素材只能由使用者在 App 裡匯入，這裡不能新增或刪除。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "kind": {
          "description": "只列這一種素材",
          "type": "string",
          "enum": [
            "image",
            "text",
            "audio"
          ]
        },
        "query": {
          "description": "名稱包含這段文字（不分大小寫）",
          "type": "string",
          "maxLength": 255
        },
        "folderId": {
          "description": "只列這個資料夾（含子資料夾）的素材；id 由本工具回傳的 folders 取得",
          "type": "string",
          "minLength": 1
        },
        "includeTrashed": {
          "description": "也列出垃圾桶裡的素材（預設 false）",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true
    }
  },
  {
    "name": "place_library_item",
    "title": "把素材放到頁面",
    "description": "把素材庫裡的圖片放到頁面或主頁（放在最上層），回傳新物件的 id 與尺寸（pt）。item 是素材 id 或名稱（名稱要完全相符；同名的素材不只一個時請改用 id）。x / y 是圖片外框左上角（pt），省略的那一軸置中於頁面。width 省略時和使用者從素材面板放到頁面相同：原始像素當 pt，太大時縮到頁面寬、高的一半以內；給 width 時高度依原圖比例算（要改比例再用 update_element）。省略 pageId = 使用者正在看的頁面；指定別頁不會切換使用者的畫面。目前只能放圖片：文字檔請讀 list_library_items 的摘錄後用 add_text，音訊不能放到頁面，垃圾桶裡的素材要使用者先還原。一次呼叫 = 一筆復原紀錄。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "item": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "素材 id 或名稱（由 list_library_items 取得）"
        },
        "pageId": {
          "type": "string",
          "minLength": 1,
          "description": "頁面或主頁的 id（由 list_pages 取得）"
        },
        "x": {
          "type": "number",
          "minimum": -10000,
          "maximum": 10000
        },
        "y": {
          "type": "number",
          "minimum": -10000,
          "maximum": 10000
        },
        "width": {
          "description": "寬度（pt），高度依原圖比例",
          "type": "number",
          "minimum": 4,
          "maximum": 10000
        }
      },
      "required": [
        "item"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false
    }
  },
